---
interface FooterAction {
	label: string
	href: string
	external?: boolean
}

interface Props {
	links: FooterAction[]
	backHref?: string
	backLabel?: string
}

const { links, backHref = '/projects/', backLabel = 'All Projects' } = Astro.props
---

<section class="project-footer-nav">
	<a href={backHref} class="footer-link footer-link--secondary">
		<svg class="footer-link-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
			<path d="M12.5 4.5L6.5 10L12.5 15.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
		{backLabel}
	</a>
	<div class="footer-link-group">
		{links.map((link) => (
			<a
				href={link.href}
				target={link.external ? '_blank' : undefined}
				rel={link.external ? 'noopener noreferrer' : undefined}
				class="footer-link footer-link--primary"
			>
				{link.label}
				<svg class="footer-link-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path d="M7 13L13 7M13 7H8M13 7V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		))}
	</div>
</section>

<style>
	.project-footer-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.footer-link-group {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.footer-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
	}

	.footer-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 0.375rem;
	}

	.footer-link-icon {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		transition: transform 0.18s ease;
	}

	.footer-link--secondary {
		padding: 0.5rem 0.25rem;
		color: var(--text-2);
	}

	.footer-link--secondary:hover {
		color: var(--text-1);
	}

	.footer-link--secondary:hover .footer-link-icon {
		transform: translateX(-3px);
	}

	.footer-link--primary {
		padding: 0.6rem 1.2rem;
		border: 1px solid color-mix(in oklch, var(--accent) 80%, var(--border));
		border-radius: 0.5rem;
		background: var(--accent);
		color: var(--btn-text);
	}

	.footer-link--primary:hover {
		background: var(--accent-text);
		box-shadow: var(--shadow-card);
		transform: translateY(-2px);
	}

	.footer-link--primary:hover .footer-link-icon {
		transform: translate(2px, -2px);
	}
</style>
