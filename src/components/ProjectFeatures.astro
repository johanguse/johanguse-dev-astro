---
interface Props {
	features: { icon: string; title: string; desc: string }[]
}

const { features } = Astro.props
---

<section class="project-features" id="key-features">
	<h2>Key Features</h2>
	<div class="feature-grid">
		{features.map((feature) => (
			<div class="feature-card">
				<span class="feature-icon" aria-hidden="true">{feature.icon}</span>
				<div>
					<h3>{feature.title}</h3>
					<p>{feature.desc}</p>
				</div>
			</div>
		))}
	</div>
</section>

<style>
	.project-features {
		margin-block: 3rem;
		scroll-margin-top: 6rem;
	}

	.project-features h2 {
		margin: 0 0 1.5rem;
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--text-1);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.feature-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.feature-card {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 1rem;
		border: 2px solid var(--border);
		border-radius: 0.375rem;
		background: var(--bg-card);
	}

	.feature-icon {
		flex-shrink: 0;
		font-size: 1.25rem;
		line-height: 1.5;
	}

	.feature-card h3 {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.5;
		color: var(--text-1);
	}

	.feature-card p {
		margin: 0.5rem 0 0;
		font-size: 0.8rem;
		line-height: 1.6;
		color: var(--text-2);
	}
</style>
