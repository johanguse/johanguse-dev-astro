<script>
	import 'vanilla-cookieconsent/dist/cookieconsent.css'
	import * as CookieConsent from 'vanilla-cookieconsent'

	declare global {
		interface Window {
			dataLayer?: unknown[]
			gtag?: (...args: unknown[]) => void
		}
	}

	function loadGTM() {
		if (document.querySelector('[data-gtm-container="GTM-TRQC29GV"]')) return

		window.dataLayer = window.dataLayer || []
		window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })

		const script = document.createElement('script')
		script.async = true
		script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-TRQC29GV'
		script.dataset.gtmContainer = 'GTM-TRQC29GV'
		document.head?.appendChild(script)
	}

	function updateGTMConsent(analytics: boolean, marketing: boolean) {
		window.gtag?.('consent', 'update', {
			analytics_storage: analytics ? 'granted' : 'denied',
			ad_storage: marketing ? 'granted' : 'denied',
			ad_user_data: marketing ? 'granted' : 'denied',
			ad_personalization: marketing ? 'granted' : 'denied',
		})
		window.dataLayer?.push({
			event: 'cookie_consent_updated',
			analytics_consent: analytics ? 'granted' : 'denied',
			marketing_consent: marketing ? 'granted' : 'denied',
		})

		if (analytics || marketing) loadGTM()
	}

	void CookieConsent.run({
		cookie: {
			name: 'johanguse_cookie_consent',
			path: '/',
			sameSite: 'Lax',
			expiresAfterDays: 365,
		},
		guiOptions: {
			consentModal: {
				layout: 'box inline',
				position: 'bottom right',
				equalWeightButtons: true,
			},
			preferencesModal: {
				layout: 'box',
				position: 'right',
				equalWeightButtons: true,
			},
		},
		categories: {
			necessary: {
				enabled: true,
				readOnly: true,
			},
			analytics: {
				enabled: false,
				readOnly: false,
				autoClear: {
					cookies: [{ name: /^_ga($|_)/ }, { name: /^_gid$/ }, { name: /^_gat/ }],
				},
			},
			marketing: {
				enabled: false,
				readOnly: false,
				autoClear: {
					cookies: [{ name: /^_twclid$/ }],
				},
			},
		},
		language: {
			default: 'en',
			translations: {
				en: {
					consentModal: {
						title: 'We use cookies',
						description:
							'We use a necessary cookie to remember your choices. With your permission, we use analytics and marketing technologies. <a href="/privacy/">Privacy Policy</a>',
						acceptAllBtn: 'Accept all',
						acceptNecessaryBtn: 'Reject optional',
						showPreferencesBtn: 'Manage preferences',
						footer: '<a href="/privacy/">Privacy Policy</a>',
					},
					preferencesModal: {
						title: 'Cookie preferences',
						acceptAllBtn: 'Accept all',
						acceptNecessaryBtn: 'Reject optional',
						savePreferencesBtn: 'Save preferences',
						closeIconLabel: 'Close',
						serviceCounterLabel: 'Service|Services',
						sections: [
							{
								title: 'How we use cookies',
								description:
									'You can choose analytics and marketing separately. Your choice can be changed at any time from the Cookie preferences link in the footer.',
							},
							{
								title: 'Strictly necessary cookies <span class="pm__badge">Always enabled</span>',
								description:
									'These cookies remember your cookie choice and are required for the consent controls to work.',
								linkedCategory: 'necessary',
							},
							{
								title: 'Analytics cookies',
								description:
									'Google Analytics 4 and Request Metrics help us understand site usage and performance. They are loaded only after you opt in.',
								linkedCategory: 'analytics',
								cookieTable: {
									headers: {
										name: 'Cookie / service',
										domain: 'Domain',
										description: 'Purpose',
										expiration: 'Expiration',
									},
									body: [
										{
											name: '_ga',
											domain: window.location.hostname,
											description: 'Google Analytics visitor identifier',
											expiration: 'Up to 2 years',
										},
										{
											name: '_gid',
											domain: window.location.hostname,
											description: 'Google Analytics session identifier',
											expiration: 'Up to 24 hours',
										},
										{
											name: 'Request Metrics local storage',
											domain: window.location.hostname,
											description: 'Session timestamp used for performance analytics; not a cookie',
											expiration: 'Set by the provider',
										},
									],
								},
							},
							{
								title: 'Marketing cookies',
								description:
									'The X website tag measures advertising effectiveness and may store or read advertising identifiers. It is loaded only after you opt in.',
								linkedCategory: 'marketing',
								cookieTable: {
									headers: {
										name: 'Cookie / service',
										domain: 'Domain',
										description: 'Purpose',
										expiration: 'Expiration',
									},
									body: [
										{
											name: '_twclid',
											domain: window.location.hostname,
											description: 'X advertising click identifier',
											expiration: '30 days',
										},
									],
								},
							},
						],
					},
				},
			},
		},
		onConsent: () => {
			updateGTMConsent(
				CookieConsent.acceptedCategory('analytics'),
				CookieConsent.acceptedCategory('marketing'),
			)
		},
		onChange: () => {
			updateGTMConsent(
				CookieConsent.acceptedCategory('analytics'),
				CookieConsent.acceptedCategory('marketing'),
			)
		},
	})

	document.addEventListener('click', (event) => {
		const button = (event.target as Element | null)?.closest('.js-manage-cookies')
		if (!button) return

		event.preventDefault()
		CookieConsent.showPreferences()
	})
</script>

