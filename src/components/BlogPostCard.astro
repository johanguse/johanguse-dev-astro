---
import { styles, sx } from "../styles/utilities.stylex";
import { formatDate } from '../utils/helpers'
import { tagToUrlPath } from '../utils/tagUrl'

interface Props {
	title: string
	date: string
	summary: string
	slug: string
	tags?: string[]
}

const { title, date, summary, slug, tags } = Astro.props
---

<li class={sx(styles.py4).class}>
	<article class={sx(styles.spaceY2, styles.xlGrid, styles.gridCols4Xl, styles.itemsBaselineXl, styles.xlSpaceY0).class}>
		<dl>
			<dt class={sx(styles.srOnly).class}>Published on</dt>
			<dd class={sx(styles.textBase, styles.fontMedium, styles.leading6, styles.textGray500, styles.textGray400).class}>
				<time datetime={date}>{formatDate(date)}</time>
			</dd>
		</dl>
		<div class={sx(styles.spaceY3, styles.colSpan3Xl).class}>
			<div>
				<h2 class={sx(styles.text2xl, styles.fontBold, styles.leading8, styles.trackingTight).class}>
					<a href={`/blog/${slug}/`} class={sx(styles.textGray900, styles.textGray900).class}>
						{title}
					</a>
				</h2>
				{tags && (
					<div class={sx(styles.flex, styles.flexWrap).class}>
						{tags.map((tag) => (
							<a href={`/tags/${tagToUrlPath(tag)}/`} class={sx(styles.mr3, styles.textSm, styles.fontMedium, styles.uppercase, styles.textPrimary500, styles.darkTextPrimary100, styles.hoverTextPrimary600, styles.darkTextWhite).class}>
								{tag}
							</a>
						))}
					</div>
				)}
			</div>
			<div class={sx(styles.maxWNone, styles.textGray500, styles.textGray400).class}>
				{summary}
			</div>
		</div>
	</article>
</li>
