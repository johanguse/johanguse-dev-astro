---
import { styles, sx } from "../styles/utilities.stylex";
interface Props {
	title: string
	description: string
	imgSrc: string
	href: string
	date?: string | undefined
	skills?: string[] | undefined
	clientName?: string | undefined
	clientURL?: string | undefined
	externalHref?: string | undefined
	/** First visible cards: eager load for LCP */
	imagePriority?: boolean
}

const {
	title,
	imgSrc,
	href,
	date,
	skills,
	clientName,
	clientURL,
	externalHref,
	imagePriority = false,
} = Astro.props

const isInternalPage = href.startsWith('/')
const displayHref = isInternalPage ? href : (externalHref ?? href)
const hasLink = displayHref.length > 0
const learnLabel = isInternalPage ? `Learn more about ${title}` : `Visit ${title} (opens in a new tab)`
---

<div class:list={["md", sx(styles.p4, styles.mdWHalf).class]} style="max-width: 544px;">
	<div class={sx(styles.flex, styles.hFull, styles.flexCol, styles.overflowHidden, styles.roundedMd, styles.border2, styles.borderGray200, styles.borderOpacity60, styles.borderGray700).class}>
		{imgSrc && (
			hasLink ? (
				<a
					href={displayHref}
					aria-label={`Open project: ${title}`}
					{...(!isInternalPage ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
				>
					<img
						alt=""
						role="presentation"
						src={imgSrc}
						class={sx(styles.objectCover, styles.objectCenter, styles.h36Md, styles.h48Lg, styles.wFull).class}
						loading={imagePriority ? 'eager' : 'lazy'}
						{...(imagePriority ? { fetchpriority: 'high' } : {})}
						width="544"
						height="336"
					/>
				</a>
			) : (
				<img
					alt=""
					src={imgSrc}
					class={sx(styles.objectCover, styles.objectCenter, styles.h36Md, styles.h48Lg, styles.wFull).class}
					loading={imagePriority ? 'eager' : 'lazy'}
					{...(imagePriority ? { fetchpriority: 'high' } : {})}
					width="544"
					height="336"
				/>
			)
		)}
		<div class={sx(styles.flex, styles.flex1, styles.flexCol, styles.p6).class}>
			<h2 class={sx(styles.mb3, styles.text2xl, styles.fontBold, styles.leading8, styles.trackingTight).class}>
				{hasLink ? (
					<a href={displayHref} {...(!isInternalPage ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
						{title}
					</a>
				) : (
					title
				)}
			</h2>
			{date && (
					<p class={sx(styles.mb05, styles.maxWNone, styles.textPrimary500, styles.darkTextWhite).class}>
					<span class={sx(styles.fontBold).class}>Date:</span> {date}
				</p>
			)}
			{skills && skills.length > 0 && (
					<p class={sx(styles.mb05, styles.maxWNone, styles.textPrimary500, styles.darkTextWhite).class}>
					<span class={sx(styles.fontBold).class}>Skills:</span> {skills.join(', ')}
				</p>
			)}
			{clientURL ? (
				<a
					href={clientURL}
					class={sx(styles.textPrimary500, styles.darkTextPrimary100, styles.hoverTextPrimary600, styles.darkTextWhite).class}
					rel="noopener noreferrer"
					target="_blank"
				>
					<p class={sx(styles.mb5).class}>
						<span class={sx(styles.fontBold).class}>Client:</span> {clientName}
					</p>
				</a>
			) : clientName ? (
				<p class={sx(styles.mb5, styles.maxWNone, styles.textGray500, styles.textGray400).class}>
					<span class={sx(styles.fontBold).class}>Client:</span> {clientName}
				</p>
			) : null}

			<div class={sx(styles.mtAuto).class}>
				{hasLink && (
					<a
						href={displayHref}
						class={sx(styles.textBase, styles.fontBold, styles.leading6, styles.textPrimary500, styles.darkTextPrimary100, styles.hoverTextPrimary600, styles.darkTextWhite).class}
						{...(!isInternalPage ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					>
						{learnLabel} &rarr;
					</a>
				)}
			</div>
		</div>
	</div>
</div>
