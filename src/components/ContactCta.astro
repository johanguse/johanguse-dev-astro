---
import ArrowFillButton from './ArrowFillButton.astro'
import { RectangularTextReveal } from './react/RectangularTextReveal'

interface Props {
  eyebrow?: string
  title?: string
  description?: string
}

const {
  eyebrow = 'Start a conversation',
  title = 'Have a useful problem to solve?',
  description = 'Tell me what you are making, where it is getting stuck, and what a good outcome looks like.',
} = Astro.props
---

<section class="contact-cta" aria-labelledby="contact-cta-heading">
  <div class="contact-cta-mark" aria-hidden="true">↗</div>
  <div class="contact-cta-copy">
    <span class="section-label">{eyebrow}</span>
    <RectangularTextReveal
      client:visible
      as="h2"
      id="contact-cta-heading"
      className="contact-cta-title"
      text={title}
    />
    <p>{description}</p>
  </div>
  <ArrowFillButton href="/contact/" className="contact-cta-link">Contact Johan</ArrowFillButton>
</section>

<style>
  .contact-cta {
    position: relative;
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(4rem, 9vw, 8rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    overflow: hidden;
    border: 1px solid var(--border);
    background: color-mix(in oklch, var(--bg-card) 78%, transparent);
    box-shadow: var(--shadow-card);
  }

  .contact-cta::before {
    position: absolute;
    inset: 0.75rem;
    border: 1px solid color-mix(in oklch, var(--accent) 18%, transparent);
    content: '';
    pointer-events: none;
  }

  .contact-cta-mark {
    position: absolute;
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    width: 3.25rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in oklch, var(--accent) 38%, transparent);
    border-radius: 50%;
    color: var(--accent);
    font-size: 1.25rem;
  }

  .contact-cta-copy {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  :global(.contact-cta-title) {
    max-width: 17ch;
    margin: 0.55rem 0 0;
    color: var(--text-1);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 750;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .contact-cta p {
    max-width: 52ch;
    margin: 1.25rem 0 0;
    color: var(--text-2);
    line-height: 1.65;
  }

  .contact-cta-link {
    position: relative;
    z-index: 1;
    justify-self: start;
  }

  @media (min-width: 760px) {
    .contact-cta {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 2rem;
    }
  }
</style>
