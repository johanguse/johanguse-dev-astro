---
import { navLinks } from '../data/siteConfig'
const currentPath = Astro.url.pathname
---

<header id="site-nav" class="nav-bar">
  <div class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Johan Guse — Home">
      <span class="nav-logo-mark">JG</span>
    </a>

    <!-- Desktop links -->
    <nav aria-label="Main" class="nav-links">
      {navLinks.filter(l => l.href !== '/').map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
        return (
          // biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders this navigation list statically.
          <a
            href={link.href}
            class:list={['nav-link', { 'nav-link--active': isActive }]}
            {...(isActive ? { 'aria-current': 'page' } : {})}
          >
            {link.title}
          </a>
        )
      })}
    </nav>

    <!-- Actions -->
    <div class="nav-actions">
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        aria-pressed="false"
        type="button"
        class="nav-toggle-btn theme-toggle-btn"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="nav-icon hidden">
          <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="nav-icon">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
        </svg>
        <span class="theme-toggle-phase" aria-hidden="true"></span>
      </button>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="nav-toggle-btn nav-mobile-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="menu-open-icon nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
        </svg>
        <svg class="menu-close-icon nav-icon hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu overlay -->
<nav
  id="mobile-menu"
  class="mobile-menu hidden"
  aria-label="Mobile navigation"
>
  <div class="mobile-menu-nav">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
      return (
        // biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders this navigation list statically.
        <a
          href={link.href}
          class:list={['mobile-menu-link', { 'mobile-menu-link--active': isActive }]}
          {...(isActive ? { 'aria-current': 'page' } : {})}
        >
          {link.title}
        </a>
      )
    })}
  </div>
</nav>

<style>
  .nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: blur(12px) saturate(1.3);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    border-bottom: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin-inline: auto;
    padding: 0 clamp(1.25rem, 5vw, 4rem);
    height: 64px;
  }

  /* Logo */
  .nav-logo {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .nav-logo-mark {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--text-1);
    line-height: 1;
    transition: color 0.15s ease;
  }

  .nav-logo:hover .nav-logo-mark {
    color: var(--accent);
  }

  /* Desktop nav */
  .nav-links {
    display: none;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .nav-links { display: flex; }
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--text-2);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 0.5rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--text-1);
    background: var(--bg-elevated);
  }

  /* Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.55rem;
    height: 2.55rem;
    border-radius: 0.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-2);
    transition: color 0.15s ease, background 0.15s ease;
  }

  /* This must follow .nav-toggle-btn so the desktop display override wins. */
  @media (min-width: 768px) {
    .nav-mobile-btn { display: none; }
  }

  .nav-toggle-btn:hover {
    color: var(--text-1);
    background: var(--bg-elevated);
  }

  .theme-toggle-btn {
    width: 2.5rem;
    height: 2.5rem;
  }

  .theme-toggle-btn > svg {
    display: none;
  }

  .theme-toggle-phase {
    width: 1.25rem;
    height: 1.25rem;
    background: url('/theme.png') left center / auto 1.25rem no-repeat;
    transition: background-position 0.4s steps(5);
  }

  :global(.dark) .theme-toggle-phase {
    background-position: right center;
  }

  .nav-icon {
    width: 1.55rem;
    height: 1.55rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle-phase {
      transition: none;
    }
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 64px 0 0 0;
    z-index: 40;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .mobile-menu.hidden {
    display: none;
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
    gap: 0.25rem;
  }

  .mobile-menu-link {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-2);
    text-decoration: none;
    padding: 0.5rem 0;
    transition: color 0.15s ease;
  }

  .mobile-menu-link:hover,
  .mobile-menu-link--active {
    color: var(--accent);
  }
</style>

<script is:inline>
  function setupNav() {
    const themeBtn = document.getElementById('theme-toggle')
    const mobileBtn = document.getElementById('mobile-menu-btn')
    const mobileMenu = document.getElementById('mobile-menu')

    function closeMobileMenu({ returnFocus = false } = {}) {
      if (!mobileBtn || !mobileMenu) return

      mobileBtn.setAttribute('aria-expanded', 'false')
      mobileBtn.setAttribute('aria-label', 'Open menu')
      mobileMenu.classList.add('hidden')
      mobileBtn.querySelector('.menu-open-icon')?.classList.remove('hidden')
      mobileBtn.querySelector('.menu-close-icon')?.classList.add('hidden')
      document.body.classList.remove('overflow-hidden')

      if (returnFocus) mobileBtn.focus()
    }

    function openMobileMenu() {
      if (!mobileBtn || !mobileMenu) return

      mobileBtn.setAttribute('aria-expanded', 'true')
      mobileBtn.setAttribute('aria-label', 'Close menu')
      mobileMenu.classList.remove('hidden')
      mobileBtn.querySelector('.menu-open-icon')?.classList.add('hidden')
      mobileBtn.querySelector('.menu-close-icon')?.classList.remove('hidden')
      document.body.classList.add('overflow-hidden')
      requestAnimationFrame(() => mobileMenu.querySelector('a')?.focus())
    }

    function syncIcons() {
      const dark = document.documentElement.classList.contains('dark')
      themeBtn?.setAttribute('aria-pressed', String(dark))
      themeBtn?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode')
    }
    syncIcons()
    requestAnimationFrame(syncIcons)

    if (themeBtn && !themeBtn.dataset.bound) {
      themeBtn.dataset.bound = 'true'
      themeBtn.addEventListener('click', () => {
        const dark = document.documentElement.classList.contains('dark')
        document.documentElement.classList.toggle('dark', !dark)
        localStorage.setItem('theme', dark ? 'light' : 'dark')
        syncIcons()
      })
    }

    if (mobileBtn && !mobileBtn.dataset.bound) {
      mobileBtn.dataset.bound = 'true'
      mobileBtn.addEventListener('click', () => {
        const open = mobileBtn.getAttribute('aria-expanded') === 'true'
        if (open) closeMobileMenu({ returnFocus: true })
        else openMobileMenu()
      })

      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => closeMobileMenu())
      })

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) closeMobileMenu()
      })
    }

    if (!document.documentElement.dataset.mobileMenuKeyboardBound) {
      document.documentElement.dataset.mobileMenuKeyboardBound = 'true'
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return

        const currentButton = document.getElementById('mobile-menu-btn')
        const currentMenu = document.getElementById('mobile-menu')
        if (currentButton?.getAttribute('aria-expanded') === 'true') {
          currentButton.click()
        }
        currentMenu?.classList.add('hidden')
      })
    }
  }

  setupNav()
  document.addEventListener('astro:page-load', setupNav)
</script>
