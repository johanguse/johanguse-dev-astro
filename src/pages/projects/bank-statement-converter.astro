---
import { styles, sx } from "../../styles/utilities.stylex";
import BaseLayout from '../../layouts/BaseLayout.astro'
import Navigation from '../../components/Navigation.astro'
import Footer from '../../components/Footer.astro'
import ContactCta from '../../components/ContactCta.astro'
---

	<BaseLayout
		title="Bank Statement Converter"
		description="AI-powered service that transforms PDF bank statements into Excel, CSV, JSON, and QBO formats with OCR."
		fullBleed
	>
	<Navigation slot="header" />

	<article class="inner-page project-page">
		<div class="container--narrow">
			<header class="project-header">
				<span class="section-label">Case study</span>
				<h1 class="page-title">
					Bank Statement Converter
				</h1>
				<p class="page-subtitle">
					Transform PDF bank statements into Excel, CSV, JSON, and QBO formats with AI
				</p>
				<div class="project-meta">
					<span class="project-meta-item">Personal Project</span>
					<span class="project-meta-item">July 2025 - Present</span>
				</div>
			</header>

			<div class={sx(styles.mb12, styles.roundedLg, styles.overflowHidden).class}>
				<img
					src="https://res.cloudinary.com/dvcywi3uf/image/upload/v1766065535/jrguse/port/bscwai-dashboard.jpg"
					alt="Bank Statement Converter Dashboard"
					class={sx(styles.wFull).class}
					loading="lazy"
				/>
			</div>

			<div class={sx(styles.spaceY12, styles.textGray900, styles.textGray900).class}>
				<section>
					<h2 class={sx(styles.text2xl, styles.fontSemibold, styles.mb4).class}>Project Overview</h2>
					<p class={sx(styles.textGray500, styles.textGray400, styles.leadingRelaxed, styles.mb4).class}>
						Bank Statement Converter is an AI-powered service that transforms PDF bank statements into Excel, CSV, JSON, and QBO format with OCR. Built on proven Resume-AI architecture, it serves individuals, small businesses, and enterprises who need structured financial data for analysis, accounting, and compliance.
					</p>
					<p class={sx(styles.textGray500, styles.textGray400, styles.leadingRelaxed, styles.fontMedium).class}>
						Convert any PDF or Docx bank statement to Excel, CSV, JSON, or QBO in under 30 seconds.
					</p>
				</section>

				<section>
					<h2 class={sx(styles.text2xl, styles.fontSemibold, styles.mb6).class}>Key Features</h2>
					<div class={sx(styles.grid, styles.gridCols1, styles.smGridCols2, styles.gap4).class}>
						{[
							{ icon: '🤖', title: 'AI-Powered OCR', desc: 'OCR accuracy on financial documents' },
							{ icon: '⚡', title: 'Instant Conversion', desc: 'PDF to Excel/CSV/JSON/QBO in under 30s' },
							{ icon: '🌍', title: 'Bank-Agnostic', desc: 'Works with 1000+ banks worldwide' },
							{ icon: '📊', title: 'Multiple Formats', desc: 'Excel, CSV, JSON, and QBO export' },
							{ icon: '🔄', title: 'Batch Processing', desc: 'Convert up to 5 files simultaneously' },
							{ icon: '🔒', title: 'Secure Storage', desc: 'Bank-grade encryption with Cloudflare R2' },
							{ icon: '📈', title: 'Usage Dashboard', desc: 'Track conversion history and limits' },
							{ icon: '💳', title: 'Flexible Pricing', desc: 'Subscriptions + pay-as-you-go credits' },
							{ icon: '🔌', title: 'API Integration', desc: 'Developer-friendly endpoints' },
							{ icon: '🏷️', title: 'Auto Categorization', desc: 'AI-powered spending analysis' },
						].map((item) => (
							// biome-ignore lint/correctness/useJsxKeyInIterable: Astro renders this feature list statically.
							<div class={sx(styles.roundedMd, styles.border2, styles.borderGray200, styles.borderOpacity60, styles.p4, styles.borderGray700).class}>
								<div class={sx(styles.flex, styles.itemsStart, styles.gap3).class}>
									<span class={sx(styles.textXl).class}>{item.icon}</span>
									<div>
										<h3 class={sx(styles.fontMedium, styles.textSm).class}>{item.title}</h3>
										<p class={sx(styles.textGray500, styles.textXs, styles.textGray400).class}>{item.desc}</p>
									</div>
								</div>
							</div>
						))}
					</div>
				</section>

				<section>
					<h2 class={sx(styles.text2xl, styles.fontSemibold, styles.mb6).class}>Tech Stack</h2>
					<div class={sx(styles.grid, styles.gridCols1, styles.mdGridCols2, styles.gap6).class}>
						<div class={sx(styles.roundedMd, styles.border2, styles.borderGray200, styles.borderOpacity60, styles.borderGray700, styles.p6).class}>
							<h3 class={sx(styles.textLg, styles.fontMedium, styles.mb3).class}>Frontend</h3>
							<ul class={sx(styles.spaceY15, styles.textGray500, styles.textGray400, styles.textSm).class}>
								<li>Next.js 15.3.4 with App Router</li>
								<li>React 19 with TypeScript</li>
								<li>TailwindCSS & Shadcn/ui</li>
								<li>Aceternity UI for animations</li>
								<li>NextAuth.js for authentication</li>
							</ul>
						</div>
						<div class={sx(styles.roundedMd, styles.border2, styles.borderGray200, styles.borderOpacity60, styles.borderGray700, styles.p6).class}>
							<h3 class={sx(styles.textLg, styles.fontMedium, styles.mb3).class}>Backend Services</h3>
							<ul class={sx(styles.spaceY15, styles.textGray500, styles.textGray400, styles.textSm).class}>
								<li>FastAPI-based microservice</li>
								<li>OCR for processing</li>
								<li>Excel, CSV, JSON, QBO generation</li>
								<li>Cloudflare R2 for file storage</li>
								<li>Transaction categorization AI</li>
							</ul>
						</div>
						<div class={sx(styles.roundedMd, styles.border2, styles.borderGray200, styles.borderOpacity60, styles.borderGray700, styles.p6).class}>
							<h3 class={sx(styles.textLg, styles.fontMedium, styles.mb3).class}>Database & Storage</h3>
							<ul class={sx(styles.spaceY15, styles.textGray500, styles.textGray400, styles.textSm).class}>
								<li>PostgreSQL with Prisma ORM</li>
								<li>Cloudflare R2 for processed files</li>
								<li>Upstash Redis for rate limiting</li>
							</ul>
						</div>
						<div class={sx(styles.roundedMd, styles.border2, styles.borderGray200, styles.borderOpacity60, styles.borderGray700, styles.p6).class}>
							<h3 class={sx(styles.textLg, styles.fontMedium, styles.mb3).class}>Payments & Deployment</h3>
							<ul class={sx(styles.spaceY15, styles.textGray500, styles.textGray400, styles.textSm).class}>
								<li>Stripe for payment processing</li>
								<li>Stripe Customer Portal</li>
								<li>Fly.io for app hosting</li>
								<li>Custom webhook handlers</li>
							</ul>
						</div>
					</div>
				</section>

				<section>
					<h2 class={sx(styles.text2xl, styles.fontSemibold, styles.mb4).class}>Business Model</h2>
					<div class={sx(styles.textGray500, styles.textGray400, styles.leadingRelaxed, styles.spaceY4).class}>
						<p>This SaaS platform serves individuals, small businesses, and enterprises who need structured financial data for analysis, accounting, and compliance. 5 subscription tiers with 20% annual billing discount.</p>
						<div class={sx(styles.grid, styles.gridCols1, styles.smGridCols3, styles.gap4).class}>
							<div class={sx(styles.roundedMd, styles.border2, styles.borderGray200, styles.borderOpacity60, styles.borderGray700, styles.p4, styles.textCenter).class}>
								<p class={sx(styles.textSm, styles.fontMedium, styles.textGray900, styles.textGray900).class}>Small Business</p>
								<p class={sx(styles.textXs, styles.textGray500, styles.textGray400, styles.mt1).class}>Bookkeepers, freelancers</p>
							</div>
							<div class={sx(styles.roundedMd, styles.border2, styles.borderGray200, styles.borderOpacity60, styles.borderGray700, styles.p4, styles.textCenter).class}>
								<p class={sx(styles.textSm, styles.fontMedium, styles.textGray900, styles.textGray900).class}>Financial Pros</p>
								<p class={sx(styles.textXs, styles.textGray500, styles.textGray400, styles.mt1).class}>Accounting firms, advisors</p>
							</div>
							<div class={sx(styles.roundedMd, styles.border2, styles.borderGray200, styles.borderOpacity60, styles.borderGray700, styles.p4, styles.textCenter).class}>
								<p class={sx(styles.textSm, styles.fontMedium, styles.textGray900, styles.textGray900).class}>Enterprise</p>
								<p class={sx(styles.textXs, styles.textGray500, styles.textGray400, styles.mt1).class}>Banks, insurance, legal</p>
							</div>
						</div>
					</div>
				</section>

				<section class={sx(styles.borderT, styles.borderGray200, styles.borderGray700, styles.pt8, styles.flex, styles.flexWrap, styles.gap4).class}>
					<a href="https://bankstatementconverterwithai.com/?utm_source=johan-website-projects" target="_blank" rel="noopener noreferrer" class={sx(styles.textPrimary500, styles.darkTextPrimary100, styles.hoverTextPrimary600, styles.darkTextWhite, styles.inlineFlex, styles.itemsCenter, styles.fontMedium).class}>
						Visit Website &rarr;
					</a>
					<a href="/projects/" class={sx(styles.textGray500, styles.hoverTextGray700, styles.textGray400, styles.hoverTextGray200, styles.inlineFlex, styles.itemsCenter, styles.fontMedium).class}>
						&larr; All Projects
					</a>
				</section>
			</div>
			<ContactCta />
		</div>
	</article>

	<Footer slot="footer" />
</BaseLayout>
