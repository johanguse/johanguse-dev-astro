---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from '../components/Navigation.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout title="Page not found" description="The requested page could not be found." fullBleed>
	<Navigation slot="header" />

	<section class="inner-page not-found" aria-labelledby="not-found-heading">
		<div class="container--narrow">
			<span class="section-label">404</span>
			<h1 id="not-found-heading">This page has moved on.</h1>
			<p>Try the homepage, browse the work, or start a conversation about what you are building.</p>
			<div class="not-found-actions">
				<a href="/" class="not-found-primary">Back to homepage <span aria-hidden="true">→</span></a>
				<a href="/contact/" class="not-found-secondary">Contact Johan</a>
			</div>
		</div>
	</section>

	<Footer slot="footer" />
</BaseLayout>

<style>
	.not-found {
		display: grid;
		place-items: center;
		text-align: center;
	}

	.not-found :global(.container--narrow) {
		max-width: 48rem;
	}

	.not-found h1 {
		margin: 0.6rem auto 0;
		color: var(--text-1);
		font-family: var(--font-display);
		font-size: clamp(3rem, 9vw, 6.5rem);
		font-weight: 800;
		letter-spacing: -0.065em;
		line-height: 0.9;
	}

	.not-found p {
		max-width: 40ch;
		margin: 1.75rem auto 0;
		color: var(--text-2);
		font-size: 1.08rem;
		line-height: 1.65;
	}

	.not-found-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.not-found-primary,
	.not-found-secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		min-height: 3rem;
		padding: 0.75rem 1rem;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
	}

	.not-found-primary {
		border: 1px solid color-mix(in oklch, var(--accent) 80%, var(--border));
		background: var(--accent);
		color: var(--btn-text);
	}

	.not-found-secondary {
		border: 1px solid var(--border);
		color: var(--text-1);
	}

	.not-found-primary:hover,
	.not-found-secondary:hover {
		transform: translateY(-2px);
	}

	.not-found-primary:hover {
		background: var(--accent-text);
	}

	.not-found-secondary:hover {
		background: var(--bg-elevated);
	}
</style>
