---
import Footer from '../components/Footer.astro'
import Navigation from '../components/Navigation.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import ArrowFillButton from '../components/ArrowFillButton.astro'
import { RectangularTextReveal } from '../components/react/RectangularTextReveal'
import { TextReveal } from '../components/react/TextReveal'

const turnstileSiteKey = '0x4AAAAAAEQOYbYqAOdD5R5f'
---

<BaseLayout
  title="Contact"
  description="Get in touch with Johan Guse about a full-stack product, AI application, or accessible web experience."
  fullBleed
>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer slot="head"></script>
  <Navigation slot="header" />

  <div class="contact-page">
    <div class="container contact-shell">
      <header class="contact-intro">
        <span class="section-label">Contact</span>
        <RectangularTextReveal
          client:load
          as="h1"
          className="contact-heading"
          text={'Make the useful\nbeautifully real.'}
          accent="beautifully real."
          staggerDelay={0.14}
        />
        <TextReveal
          client:load
          as="p"
          className="contact-intro-copy"
          text="Tell me what you’re building, where it’s stuck, and what a useful outcome looks like."
          staggerDelay={0.022}
          duration={0.42}
        />
        <p class="contact-availability"><span aria-hidden="true"></span>Available for selected collaborations</p>
      </header>

      <section class="contact-form-panel" aria-labelledby="contact-form-heading">
          <div class="contact-form-heading">
            <div>
              <h2 id="contact-form-heading">Your project, in brief.</h2>
              <p>Fields marked with an asterisk are required.</p>
            </div>
          </div>

          <form id="contact-form" action="/api/contact" method="post" novalidate>
            <div class="contact-form-row">
              <div class="contact-field">
                <label for="name">Name <span aria-hidden="true">*</span></label>
                <input id="name" name="name" autocomplete="name" required maxlength="120" />
              </div>
              <div class="contact-field">
                <label for="email">Email <span aria-hidden="true">*</span></label>
                <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
              </div>
            </div>

            <div class="contact-field">
              <label for="company">Company or project <span>(optional)</span></label>
              <input id="company" name="company" autocomplete="organization" maxlength="160" />
            </div>

            <div class="contact-field">
              <label for="message">What are you trying to make? <span aria-hidden="true">*</span></label>
              <textarea id="message" name="message" rows="6" required maxlength="5000"></textarea>
            </div>

            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-action="turnstile-spin-v1"
              data-theme="auto"
            ></div>

            <div class="contact-form-footer">
              <ArrowFillButton type="submit" className="contact-submit">Send message</ArrowFillButton>
              <p id="contact-form-status" class="contact-form-status" role="status" aria-live="polite"></p>
            </div>
          </form>
      </section>
    </div>
  </div>

  <Footer slot="footer" showCta={false} />
</BaseLayout>

<script is:inline>
  let contactFormAbortController = null
  let contactTurnstileWidgetId = null
  let contactTurnstileLoadAttempts = 0

  function resetContactTurnstile() {
    if (window.turnstile && contactTurnstileWidgetId !== null) {
      window.turnstile.reset(contactTurnstileWidgetId)
    }
  }

  function initContactForm() {
    const form = document.getElementById('contact-form')
    const status = document.getElementById('contact-form-status')
    const submitButton = form?.querySelector('button[type="submit"]')
    const turnstileContainer = form?.querySelector('.cf-turnstile')

    if (!(form instanceof HTMLFormElement) || !status || !(submitButton instanceof HTMLButtonElement)) return

    if (contactFormAbortController) contactFormAbortController.abort()
    contactFormAbortController = new AbortController()

    form.querySelectorAll('input, select, textarea').forEach((field) => {
      field.addEventListener('invalid', () => field.setAttribute('aria-invalid', 'true'), {
        signal: contactFormAbortController.signal,
      })
      field.addEventListener('input', () => {
        if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
          if (field.validity.valid) field.removeAttribute('aria-invalid')
        }
      }, { signal: contactFormAbortController.signal })
    })

    if (turnstileContainer && !window.turnstile) {
      if (contactTurnstileLoadAttempts < 20) {
        contactTurnstileLoadAttempts += 1
        window.setTimeout(initContactForm, 100)
        return
      }

      status.textContent = 'The security check could not load. Please refresh and try again.'
      status.dataset.state = 'error'
      return
    }

    if (turnstileContainer && window.turnstile) {
      contactTurnstileLoadAttempts = 0
      if (contactTurnstileWidgetId !== null) {
        try {
          window.turnstile.remove(contactTurnstileWidgetId)
        } catch {}
      }

      turnstileContainer.innerHTML = ''
      contactTurnstileWidgetId = window.turnstile.render(turnstileContainer, {
        sitekey: turnstileContainer.getAttribute('data-sitekey'),
        action: turnstileContainer.getAttribute('data-action'),
        theme: turnstileContainer.getAttribute('data-theme') || 'auto',
        'error-callback': () => {
          status.textContent = 'The security check could not load. Please refresh and try again.'
          status.dataset.state = 'error'
        },
      })
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      if (!form.reportValidity()) return

      const formData = new FormData(form)
      if (!formData.get('cf-turnstile-response')) {
        status.textContent = 'Please complete the security check before sending your message.'
        status.dataset.state = 'error'
        return
      }

      submitButton.disabled = true
      form.setAttribute('aria-busy', 'true')
      const buttonLabel = submitButton.querySelector('.arrow-fill-button__text')
      if (buttonLabel) buttonLabel.textContent = 'Sending…'
      status.textContent = 'Sending your message…'
      status.dataset.state = 'pending'

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        })
        const body = await response.json()

        if (!response.ok) throw new Error(body.error || 'Your message could not be sent.')

        form.reset()
        status.textContent = body.message
        status.dataset.state = 'success'
        resetContactTurnstile()
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Your message could not be sent.'
        status.dataset.state = 'error'
        resetContactTurnstile()
      } finally {
        submitButton.disabled = false
        form.removeAttribute('aria-busy')
        const buttonLabel = submitButton.querySelector('.arrow-fill-button__text')
        if (buttonLabel) buttonLabel.textContent = 'Send message'
      }
    }, { signal: contactFormAbortController.signal })
  }

  document.addEventListener('astro:page-load', initContactForm)
  document.addEventListener('astro:before-swap', () => contactFormAbortController?.abort())

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm, { once: true })
  } else {
    initContactForm()
  }
</script>

<style>
  .contact-page {
    min-height: 100svh;
    padding-block: calc(64px + clamp(2.5rem, 6vw, 5rem)) clamp(4rem, 8vw, 8rem);
  }

  .contact-shell {
    max-width: 52rem;
  }

  .contact-intro {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  :global(.contact-heading) {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.065em;
    line-height: 0.92;
    color: var(--text-1);
  }

  :global(.contact-intro-copy) {
    max-width: 56ch;
    margin: 1.5rem 0 0;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--text-2);
  }

  .contact-availability {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1.25rem 0 0;
    color: var(--text-3);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .contact-availability span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: oklch(0.65 0.2 145);
  }

  .contact-form-panel {
    border: 1px solid var(--border);
    background: color-mix(in oklch, var(--bg-card) 78%, transparent);
    box-shadow: var(--shadow-card);
  }
  .contact-form-heading {
    display: flex;
    gap: 1rem;
  }

  .contact-form-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
    color: var(--text-1);
  }


  .contact-form-panel {
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .contact-form-heading {
    position: relative;
    z-index: 1;
    align-items: flex-start;
    margin-bottom: 2rem;
  }

  .contact-form-heading p {
    margin: 0.5rem 0 0;
    color: var(--text-3);
    font-size: 0.9rem;
  }

  form {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
  }

  .contact-form-row {
    display: grid;
    gap: 1.25rem;
  }

  .contact-field {
    display: grid;
    gap: 0.55rem;
  }

  .contact-field label {
    color: var(--text-2);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .contact-field label span {
    color: var(--accent);
  }

  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    width: 100%;
    min-height: 3rem;
    appearance: none;
    border: 1px solid var(--border);
    border-radius: 0;
    background: color-mix(in oklch, var(--bg) 76%, var(--bg-card));
    color: var(--text-1);
    font: inherit;
    line-height: 1.45;
    padding: 0.75rem 0.9rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .contact-field textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .contact-field input:focus,
  .contact-field select:focus,
  .contact-field textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent) 24%, transparent);
    outline: none;
  }

  .contact-field input:focus-visible,
  .contact-field select:focus-visible,
  .contact-field textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .contact-form-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }

  .contact-submit {
    --arrow-fill-background: var(--accent);
  }

  .contact-form-status {
    flex: 1 1 14rem;
    min-height: 1.4em;
    margin: 0;
    color: var(--text-3);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .contact-form-status[data-state='success'] { color: var(--text-1); }
  .contact-form-status[data-state='error'] { color: var(--accent-text); }

  @media (min-width: 700px) {
    .contact-form-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
