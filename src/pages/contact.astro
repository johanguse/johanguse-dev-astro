---
import Footer from '../components/Footer.astro'
import Navigation from '../components/Navigation.astro'
import { siteConfig } from '../data/siteConfig'
import BaseLayout from '../layouts/BaseLayout.astro'

const turnstileSiteKey = '0x4AAAAAAEQOYbYqAOdD5R5fv'
---

<BaseLayout
  title="Contact"
  description="Get in touch with Johan Guse about a full-stack product, AI application, or accessible web experience."
  fullBleed
>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer slot="head"></script>
  <Navigation slot="header" />

  <div class="contact-page">
    <div class="container contact-shell">
      <header class="contact-intro">
        <div class="contact-intro-copy">
          <span class="section-label">Contact</span>
          <h1>Let’s make the useful thing <em>beautifully real.</em></h1>
          <p>
            Tell me what you’re building, where it’s stuck, or what needs a sharper point of
            view. I take on thoughtful product, AI, and accessibility-focused web work.
          </p>
        </div>

        <aside class="contact-note" aria-label="Availability">
          <span class="contact-note-mark" aria-hidden="true">01</span>
          <p class="contact-note-label">Currently</p>
          <p class="contact-note-title">Available for selected collaborations</p>
          <p class="contact-note-copy">The best starting point is a clear problem and an honest scope.</p>
        </aside>
      </header>

      <div class="contact-grid">
        <section class="contact-details" aria-labelledby="contact-details-heading">
          <div class="contact-detail-heading">
            <span class="contact-index" aria-hidden="true">A</span>
            <h2 id="contact-details-heading">A good note is enough to start.</h2>
          </div>

          <div class="contact-detail-list">
            <a href={`mailto:${siteConfig.email}`} class="contact-detail">
              <span class="contact-detail-label">Email</span>
              <span class="contact-detail-value">{siteConfig.email}</span>
              <span class="contact-detail-arrow" aria-hidden="true">↗</span>
            </a>
            <a href={siteConfig.linkedin} class="contact-detail" target="_blank" rel="noopener noreferrer">
              <span class="contact-detail-label">LinkedIn</span>
              <span class="contact-detail-value">Connect professionally</span>
              <span class="contact-detail-arrow" aria-hidden="true">↗</span>
            </a>
          </div>

          <p class="contact-details-footnote">
            Prefer email? That works too. The form sends directly to my inbox.
          </p>
        </section>

        <section class="contact-form-panel" aria-labelledby="contact-form-heading">
          <div class="contact-form-heading">
            <span class="contact-index" aria-hidden="true">B</span>
            <div>
              <h2 id="contact-form-heading">Your project, in brief.</h2>
              <p>Fields marked with an asterisk are required.</p>
            </div>
          </div>

          <form id="contact-form" action="/api/contact" method="post" novalidate>
            <div class="contact-form-row">
              <div class="contact-field">
                <label for="name">Name <span aria-hidden="true">*</span></label>
                <input id="name" name="name" autocomplete="name" required maxlength="120" />
              </div>
              <div class="contact-field">
                <label for="email">Email <span aria-hidden="true">*</span></label>
                <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
              </div>
            </div>

            <div class="contact-form-row">
              <div class="contact-field">
                <label for="company">Company or project</label>
                <input id="company" name="company" autocomplete="organization" maxlength="160" />
              </div>
              <div class="contact-field">
                <label for="projectType">What do you need?</label>
                <select id="projectType" name="projectType">
                  <option value="">Choose one</option>
                  <option>New product or SaaS</option>
                  <option>AI feature or automation</option>
                  <option>Website or portfolio</option>
                  <option>Accessibility improvement</option>
                  <option>Existing product support</option>
                </select>
              </div>
            </div>

            <div class="contact-field">
              <label for="message">What are you trying to make? <span aria-hidden="true">*</span></label>
              <textarea id="message" name="message" rows="6" required maxlength="5000"></textarea>
            </div>

            <div class="contact-honeypot" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-action="turnstile-spin-v1"
            ></div>

            <div class="contact-form-footer">
              <button type="submit" class="contact-submit">Send message <span aria-hidden="true">→</span></button>
              <p id="contact-form-status" class="contact-form-status" role="status" aria-live="polite"></p>
            </div>
          </form>
        </section>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  const form = document.getElementById('contact-form')
  const status = document.getElementById('contact-form-status')
  const submitButton = form?.querySelector('button[type="submit"]')

  if (form instanceof HTMLFormElement && status && submitButton instanceof HTMLButtonElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      if (!form.reportValidity()) return

      submitButton.disabled = true
      submitButton.textContent = 'Sending…'
      status.textContent = 'Sending your message…'
      status.dataset.state = 'pending'

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
        const body = await response.json()

        if (!response.ok) throw new Error(body.error || 'Your message could not be sent.')

        form.reset()
        status.textContent = body.message
        status.dataset.state = 'success'
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Your message could not be sent.'
        status.dataset.state = 'error'
        globalThis.turnstile?.reset?.()
      } finally {
        submitButton.disabled = false
        submitButton.innerHTML = 'Send message <span aria-hidden="true">→</span>'
      }
    })
  }
</script>

<style>
  .contact-page {
    min-height: 100svh;
    padding-block: calc(64px + clamp(3.5rem, 8vw, 7rem)) clamp(4rem, 8vw, 8rem);
  }

  .contact-shell {
    position: relative;
  }

  .contact-shell::before {
    content: '';
    position: absolute;
    width: clamp(9rem, 20vw, 18rem);
    aspect-ratio: 1;
    right: clamp(0rem, 8vw, 8rem);
    top: 2.5rem;
    border: 1px solid color-mix(in oklch, var(--accent) 38%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }

  .contact-intro {
    display: grid;
    gap: 3rem;
    padding-bottom: clamp(3rem, 7vw, 6rem);
    border-bottom: 1px solid var(--border);
  }

  .contact-intro-copy {
    position: relative;
    z-index: 1;
    max-width: 50rem;
  }

  .contact-intro h1 {
    max-width: 13ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 9vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.065em;
    line-height: 0.88;
    color: var(--text-1);
  }

  .contact-intro h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .contact-intro-copy > p {
    max-width: 56ch;
    margin: 2rem 0 0;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--text-2);
  }

  .contact-note,
  .contact-form-panel {
    border: 1px solid var(--border);
    background: color-mix(in oklch, var(--bg-card) 78%, transparent);
    box-shadow: var(--shadow-card);
  }

  .contact-note {
    position: relative;
    overflow: hidden;
    align-self: end;
    padding: 1.5rem;
  }

  .contact-note::after {
    content: '';
    position: absolute;
    inset: auto -2.25rem -2.25rem auto;
    width: 7rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.12;
  }

  .contact-note-mark,
  .contact-index {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .contact-note-label {
    margin: 3rem 0 0.5rem;
    color: var(--text-3);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-note-title {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--text-1);
  }

  .contact-note-copy {
    max-width: 28ch;
    margin: 1rem 0 0;
    color: var(--text-2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .contact-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .contact-details {
    align-self: start;
    padding: 1.5rem 0;
  }

  .contact-detail-heading,
  .contact-form-heading {
    display: flex;
    gap: 1rem;
  }

  .contact-detail-heading h2,
  .contact-form-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
    color: var(--text-1);
  }

  .contact-detail-list {
    margin-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .contact-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease, padding 0.18s ease;
  }

  .contact-detail:hover {
    padding-inline: 0.4rem;
    color: var(--accent);
  }

  .contact-detail-label {
    color: var(--text-3);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-detail-value {
    grid-column: 1;
    color: var(--text-1);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .contact-detail-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-size: 1.25rem;
  }

  .contact-details-footnote {
    max-width: 32ch;
    margin: 1.5rem 0 0;
    color: var(--text-3);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .contact-form-panel {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .contact-form-panel::before {
    content: '';
    position: absolute;
    inset: 0.75rem;
    border: 1px solid color-mix(in oklch, var(--accent) 17%, transparent);
    pointer-events: none;
  }

  .contact-form-heading {
    position: relative;
    z-index: 1;
    align-items: flex-start;
    margin-bottom: 2.5rem;
  }

  .contact-form-heading p {
    margin: 0.5rem 0 0;
    color: var(--text-3);
    font-size: 0.9rem;
  }

  form {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
  }

  .contact-form-row {
    display: grid;
    gap: 1.25rem;
  }

  .contact-field {
    display: grid;
    gap: 0.55rem;
  }

  .contact-field label {
    color: var(--text-2);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .contact-field label span {
    color: var(--accent);
  }

  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    width: 100%;
    min-height: 3rem;
    appearance: none;
    border: 1px solid var(--border);
    border-radius: 0;
    background: color-mix(in oklch, var(--bg) 76%, var(--bg-card));
    color: var(--text-1);
    font: inherit;
    line-height: 1.45;
    padding: 0.75rem 0.9rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .contact-field select {
    background-image: linear-gradient(45deg, transparent 50%, var(--text-2) 50%), linear-gradient(135deg, var(--text-2) 50%, transparent 50%);
    background-position: calc(100% - 1.1rem) 50%, calc(100% - 0.8rem) 50%;
    background-repeat: no-repeat;
    background-size: 0.3rem 0.3rem;
    padding-right: 2.5rem;
  }

  .contact-field textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .contact-field input:focus,
  .contact-field select:focus,
  .contact-field textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent) 24%, transparent);
    outline: none;
  }

  .contact-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .contact-form-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }

  .contact-submit {
    min-height: 3rem;
    border: 1px solid color-mix(in oklch, var(--accent) 80%, var(--border));
    border-radius: 0;
    background: var(--accent);
    color: var(--btn-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.75rem 1.1rem;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .contact-submit:hover:not(:disabled) {
    background: var(--accent-text);
    transform: translateY(-2px);
  }

  .contact-submit:disabled {
    cursor: wait;
    opacity: 0.68;
  }

  .contact-form-status {
    flex: 1 1 14rem;
    min-height: 1.4em;
    margin: 0;
    color: var(--text-3);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .contact-form-status[data-state='success'] { color: var(--text-1); }
  .contact-form-status[data-state='error'] { color: var(--accent-text); }

  @media (min-width: 700px) {
    .contact-intro {
      grid-template-columns: minmax(0, 1fr) 17rem;
      align-items: end;
    }

    .contact-form-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
      gap: clamp(3rem, 8vw, 8rem);
    }

    .contact-details {
      padding-top: 2rem;
    }
  }
</style>
