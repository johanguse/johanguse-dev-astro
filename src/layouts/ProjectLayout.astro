---
import ContactCta from '../components/ContactCta.astro'
import Footer from '../components/Footer.astro'
import Navigation from '../components/Navigation.astro'
import ProjectFooterNav from '../components/ProjectFooterNav.astro'
import type { Project } from '../types'
import BaseLayout from './BaseLayout.astro'

interface Props {
	project: Project
	subtitle: string
	imageAlt: string
	screenshots?: { src: string; alt: string }[]
	screenshotLayout?: 'mobile' | 'website'
}

const { project, subtitle, imageAlt, screenshots = [], screenshotLayout = 'mobile' } = Astro.props
---

<BaseLayout title={project.title} description={project.description} ogImage={project.imgSrc} fullBleed>
	<Navigation slot="header" />
	<article class="inner-page project-page">
		<div class="container--narrow">
			<header class="project-header">
				<span class="section-label">Case study</span>
				<h1 class="page-title">{project.title}</h1>
				<p class="page-subtitle">{subtitle}</p>
				<div class="project-meta">
					{project.clientName && <span class="project-meta-item">{project.clientName}</span>}
					{project.date && <span class="project-meta-item">{project.date}</span>}
				</div>
			</header>

			<img class="project-hero" src={project.imgSrc} alt={imageAlt} fetchpriority="high" />

			<div class="case-study-content">
				<slot />

				{screenshots.length > 0 && (
					<section>
						<h2>Screenshots</h2>
						<div class:list={['project-screenshots', { 'project-screenshots--website': screenshotLayout === 'website' }]}>
							{screenshots.map((shot) => (
								<figure>
									<img src={shot.src} alt={shot.alt} loading="lazy" />
								</figure>
							))}
						</div>
					</section>
				)}

				<section>
					<h2>Tech Stack</h2>
					<ul class="project-skills" aria-label="Technologies used">
						{project.skills?.map((skill) => <li>{skill}</li>)}
					</ul>
				</section>

				<ProjectFooterNav links={project.externalHref ? [{ label: 'Visit Website', href: project.externalHref, external: true }] : []} />
			</div>
			<ContactCta />
		</div>
	</article>
	<Footer slot="footer" />
</BaseLayout>

<style>
	.project-header .page-title {
		font-size: clamp(2.25rem, 7vw, 5rem);
		overflow-wrap: anywhere;
	}

	.project-hero {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		margin-bottom: 3rem;
	}

	.case-study-content {
		display: grid;
		gap: 3rem;
		color: var(--text-2);
		line-height: 1.75;
	}

	.case-study-content :global(h2) {
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--text-1);
		margin-bottom: 1rem;
	}

	.case-study-content :global(p + p) {
		margin-top: 1rem;
	}

	.case-study-content :global(strong) {
		color: var(--text-1);
	}

	.case-study-content :global(section > ul) {
		list-style: disc;
		padding-left: 1.25rem;
	}

	.case-study-content :global(section > ul > li + li) {
		margin-top: 0.75rem;
	}

	.project-screenshots {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.project-screenshots {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.project-screenshots figure {
		margin: 0;
	}

	.project-screenshots--website {
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.project-screenshots img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
	}

	.case-study-content .project-skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		list-style: none;
	}

	.case-study-content .project-skills li {
		margin: 0;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		background: var(--bg-elevated);
		font-size: 0.85rem;
	}
</style>
