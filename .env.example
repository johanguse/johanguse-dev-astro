# Used by the Cloudflare Worker for server-side Turnstile validation.
#
# Local Worker development: copy this file to `.dev.vars` and add the real
# secret that belongs to the site key in `src/pages/contact.astro`.
# Production: add this exact variable as a Worker secret in the Cloudflare
# dashboard. Do not commit the real value to `.env`, `.dev.vars`, or Git.
TURNSTILE_SECRET_KEY=replace_with_your_turnstile_secret_key
